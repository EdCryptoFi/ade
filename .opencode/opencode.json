{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".opencode/gsd-core/*": "allow"
    },
    "external_directory": {
      ".opencode/gsd-core/*": "allow"
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills/graphify",
      ".opencode/skills/design",
      ".opencode/skills/eng",
      ".opencode/skills/gsd"
    ]
  },
  "mcp": {
    "gsd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server"
      ],
      "enabled": true
    }
  }
}